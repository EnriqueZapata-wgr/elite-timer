{
  "expo": {
    "name": "ATP",
    "slug": "EliteTimer",
    "version": "1.9.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "atp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.atpperformance.app",
      "buildNumber": "2",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSMicrophoneUsageDescription": "ATP necesita el micrófono para que puedas dictar tus registros y conversar por voz con ARGOS, tu asistente de rendimiento, en vez de escribir.",
        "NSSpeechRecognitionUsageDescription": "ATP convierte tu voz en texto para que registres comidas, entrenamientos y notas de journal hablando, sin teclear.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 19,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
      ],
      "package": "com.atpperformance.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-audio",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "ATP necesita acceso a tus fotos para que puedas registrar tus comidas, tus suplementos y tus estudios de laboratorio desde imágenes que ya tienes.",
          "cameraPermission": "ATP necesita la cámara para que puedas fotografiar tus comidas, tus suplementos y tus estudios de laboratorio."
        }
      ],
      "@react-native-community/datetimepicker",
      "react-native-health-connect",
      "./plugins/with-health-connect-delegate",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "ATP lee tus entrenamientos (tipo, duración, distancia, calorías y frecuencia cardiaca media) para registrarlos en tu pilar Fitness. Solo lectura: nada se escribe ni se comparte.",
          "NSHealthUpdateUsageDescription": "ATP no escribe información en Salud. Solo lee tus entrenamientos para registrarlos en tu pilar Fitness.",
          "background": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "ATP necesita el micrófono para que puedas dictar tus registros y conversar por voz con ARGOS, tu asistente de rendimiento, en vez de escribir.",
          "speechRecognitionPermission": "ATP convierte tu voz en texto para que registres comidas, entrenamientos y notas de journal hablando, sin teclear."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ATP SOL necesita tu ubicación mientras usas la app para mostrar el índice UV de tu zona y calcular tu ventana de vitamina D.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "atp-v5",
          "project": "atp-mobile",
          "url": "https://sentry.io/"
        }
      ],
      "expo-localization",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "ATP necesita la cámara para que puedas fotografiar tus comidas, tus suplementos y tus estudios de laboratorio, y para escanear el código de barras de un producto.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "https://itqkfozqvpwikogggqng.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Iml0cWtmb3pxdnB3aWtvZ2dncW5nIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzM5NDU1MjMsImV4cCI6MjA4OTUyMTUyM30.3jVL6LHdBJn0x8LtkXo-S7m4_kq_1zAmU_iEBfBM28E",
