# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Andamiaje local de agentes/skills (Cowork/Claude Code) — NUNCA al repo ni al
# build nativo. Contienen symlinks (ej. .agents/skills/mediabunny) que rompen
# el tarball de EAS en Windows (EPERM symlink).
.agents/
.claude/

# dependencies
node_modules/

# Expo
# MB-0(c): .expo/types (typed routes) y expo-env.d.ts SÍ se versionan — el CI
# typechequea sin dev server y los necesita. Regenerados por `expo start`;
# si cambian rutas, commitear el router.d.ts actualizado.
.expo/*
!.expo/types/
dist/
web-build/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# Adicionales — security hardening
.env.production
.env.staging
supabase/.env
supabase/functions/.env
*.p8

# Sentry
sentry.properties
**/sentry.properties

# Cowork ↔ Claude Code: solo el buzón activo del momento se ignora (rota).
# Los reportes históricos y los buzones de cowork_handoff/ SÍ se versionan
# para trazabilidad de sprints (auditoría + historia del proyecto).
COWORK_TASK.md
COWORK_REPORT_FASE4.md

# Supabase CLI temp files (estado local del cli, no compartible)
supabase/.temp/

# Claude Code local settings
.claude/settings.local.json

# @generated expo-cli sync-2b81b286409207a5da26e14c78851eb30d8ccbdb
# The following patterns were generated by expo-cli

expo-env.d.ts
# @end expo-cli

# Respaldo local de Expo: se regenera, no se versiona.
.expo-backup/

# Logs de herramientas de navegador: ruido, no fuente.
.playwright-mcp/

# Entorno de pruebas en Linux (docs/PRUEBAS_EN_LINUX.md). Por default vive en
# /tmp, fuera del repo. Estas entradas son el seguro por si alguien apunta
# ATP_TEST_CACHE o ATP_LINUX_DEPS hacia adentro: son binarios y cache, se
# regeneran solos y jamás deben viajar al repo ni al build nativo.
.test-linux/
atp-linux-deps/

# Capturas del audit visual: se regeneran con npm run audit-visual.
.maestro/capturas/

scripts/testing/vitest.linux.config.mts.timestamp-*.mjs
